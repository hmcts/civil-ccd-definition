{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>hmcts/.github:renovate-config", "local>hmcts/.github//renovate/automerge-all"],
  "labels": ["dependencies"],
  "timezone": "Europe/London",
  "automergeSchedule": ["after 7am and before 9am every weekday", "after 5pm and before 8pm every weekday"],
  "platformAutomerge": false,
  "schedule": ["after 7am and before 9am every weekday", "after 5pm and before 8pm every weekday"],
  "rebaseWhen": "behind-base-branch",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "helmv3": {
    "bumpVersion": "patch"
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sARG .*?_VERSION=(?<currentValue>.*)\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "All non-major updates",
      "groupSlug": "all-non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep the cnp-jenkins-library @Library bump in Jenkinsfiles out of the npm non-major group so pipeline changes are tested on their own",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "hmcts/cnp-jenkins-library"
      ],
      "groupName": "Jenkins library",
      "groupSlug": "jenkins-library"
    },
    {
      "matchManagers": ["helmv3"],
      "groupName": "Helm chart updates",
      "groupSlug": "helm-charts",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackageNames": ["@playwright/test", "playwright-core", "@axe-core/playwright"],
      "groupName": "Playwright",
      "groupSlug": "playwright",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Held at 2.x (#6484). Version 3 drops the outputFolder reporter option (it uses resultsDir), and playwright.config.ts and the allure generate scripts rely on outputFolder. Re-enable after moving the config and scripts to resultsDir",
      "matchPackageNames": ["allure-playwright"],
      "enabled": false
    },
    {
      "description": "Held at ^15 after ^17 was rolled back in DTSCCI-000 Fix Pipelines (#6514); the reason was not recorded. lint-staged 17 needs Node >=22.22.1 and is ESM-only. Check the pre-commit hook and pipelines on a newer version before re-enabling",
      "matchPackageNames": ["lint-staged"],
      "enabled": false
    },
    {
      "description": "Held below 12 after mocha 12 broke the full functional tests (#6981). mocha-multi loads reporters with require('mocha/lib/reporters/base') from the top-level mocha, and mocha 12 is ESM-only. CodeceptJS 4 uses its own nested mocha 12",
      "matchPackageNames": ["mocha"],
      "allowedVersions": "<12"
    },
    {
      "groupName": "Allure reporting",
      "groupSlug": "allure",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": ["/^allure-/"]
    },
    {
      "matchPackageNames": ["eslint", "typescript-eslint", "/^@eslint//", "/^@typescript-eslint//", "/^eslint-/"],
      "groupName": "ESLint",
      "groupSlug": "eslint",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "typescript-eslint 8 only supports TypeScript <6.1.0. Remove once typescript-eslint supports TypeScript 7.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "matchPackageNames": ["typescript", "/^@types//"],
      "groupName": "TypeScript",
      "groupSlug": "typescript",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "groupName": "Java dependencies",
      "groupSlug": "java-deps",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": ["/^org\\.junit\\./", "/^org\\.slf4j:/"]
    },
    {
      "matchPackageNames": ["node", "gradle", "yarn"],
      "groupName": "Build tools",
      "groupSlug": "build-tools",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
